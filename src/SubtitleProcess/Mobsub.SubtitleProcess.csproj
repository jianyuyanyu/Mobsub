<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseOneOcrSharpOnnx Condition="'$(UseOneOcrSharpOnnx)' == ''">false</UseOneOcrSharpOnnx>
    <DefineConstants Condition="'$(UseOneOcrSharpOnnx)' == 'true'">$(DefineConstants);USE_ONEOCR_SHARP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubtitleParse\Mobsub.SubtitleParse.csproj" />
    <ProjectReference Include="..\Helper\Mobsub.Helper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AC.SnippingToolOcrCore" Version="1.0.3" />
    <PackageReference Include="LibGit2Sharp.NativeBinaries" Version="2.0.323" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
    <PackageReference Include="OneOcrSharp.Onnx" Version="0.1.0" Condition="'$(UseOneOcrSharpOnnx)' == 'true'" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.IO.Packaging" Version="8.0.1" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="16.3.0" />
    <PackageReference Include="XenoAtom.Interop.libgit2" Version="1.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseOneOcrSharpOnnx)' != 'true'">
    <Compile Remove="ImageSubtitleOcr.OneOcrSharp.cs" />
  </ItemGroup>

</Project>
